@startuml

'--------------'
'Hidden members'
'--------------'
hide empty members

'----'
'Game'
'----'
class GameService {
    + createGame()
    + handleButtonClick()
    + resetValidMoves()
}

class Game {
    - {static} moveDirector
    - chessboard
    - players
    - move
    + {static} create()
    + {static} restart()
    + changeTurn()
    + handleButtonClick()
}

class Chessboard {
    + create()
    + createEmpty()
    + createOneStepBeyond()
    + getField()
    + getKingField()
    + setKingFieldColors()
    + setValidMoveColors()
    + enableValidMoves()
    + resetValidMoves()
}

class MoveDirector {
    + performFromMove()
    + performToMove()
    + performResetMove()
}

'---------'
'Relations'
'---------'
GameService ..> Game
GameService ..> Chessboard
Game -left-* Chessboard
Game -right-* MoveDirector

@enduml
