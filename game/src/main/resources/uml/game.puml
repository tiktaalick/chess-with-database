@startuml

'--------------'
'Hidden members'
'--------------'
hide empty members

'----'
'Game'
'----'
class GameService {
    + createGame()
    + handleButtonClick()
    + resetValidMoves()
}

class Game {
    - {static} moveDirector
    - {static} chessboardDirector
    - chessboard
    - players
    - move
    + {static} create()
    + {static} restart()
    + changeTurn()
    + handleButtonClick()
}

class Chessboard {
    + create()
    + createEmpty()
    + createFuture()
    + getField()
    + getKingField()
    + setKingFieldColors()
    + setValidMoveColors()
    + enableValidMoves()
    + resetValidMoves()
}

class ChessboardDirector {
    - {static} chessboardBuilder
    + createChessboard()
    + createChildren()
}

class ChessboardBuilder {
    + setChessboard()
    + createChessboard()
    + createChildren()
    + resetValidMoves()
    + build()
    + buildChildren()
}

class MoveDirector {
    + performFromMove()
    + performToMove()
    + performResetMove()
}

'---------'
'Relations'
'---------'
GameService ..> Game
GameService ..> Chessboard
Game -left-* Chessboard
Game -down-* MoveDirector
Game -down-* ChessboardDirector
ChessboardDirector --* ChessboardBuilder

@enduml
